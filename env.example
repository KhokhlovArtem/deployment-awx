# Copy to .env and edit. .env is gitignored.
# Loaded by Ansible via the env lookup (see playbooks/install.yml).

# --- Kubernetes / k3s ---
K3S_VERSION=stable
AWX_NAMESPACE=awx

# --- AWX Operator ---
AWX_OPERATOR_VERSION=2.19.1

# --- AWX instance ---
AWX_NODEPORT=30080
AWX_ADMIN_USER=admin

# --- Secrets (CHANGE THESE) ---
AWX_ADMIN_PASSWORD=change-me-strong
AWX_POSTGRES_PASSWORD=change-me-db-strong
