apiVersion: awx.ansible.com/v1beta1
kind: AWX
metadata:
  name: {{ awx_instance_name }}
  namespace: {{ awx_namespace }}
spec:
  service_type: nodeport
  nodeport_port: {{ awx_nodeport }}
  admin_user: {{ awx_admin_user }}
  admin_password_secret: {{ awx_admin_secret_name }}
  postgres_configuration_secret: {{ awx_postgres_secret_name }}
  task_extra_env: |
    - name: RES_OPTIONS
      value: ndots:1
  ee_extra_env: |
    - name: RES_OPTIONS
      value: ndots:1
{% if awx_receptor_ca_generation | length > 0 %}
  task_annotations: |
    receptor-ca-generation: "{{ awx_receptor_ca_generation }}"
{% endif %}
